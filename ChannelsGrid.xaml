<Window x:Class="ChannelsGrid"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="All Channels" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource InnerBackground}">
    <Grid>
        <ScrollViewer>
            <WrapPanel x:Name="WrapChannels" Margin="20" />
        </ScrollViewer>

        <Button x:Name="BtnHome" Content="HOME" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Padding="10,6" Margin="10" Background="#FF223344" Foreground="White" FontWeight="Bold" />
    </Grid>
</Window>
