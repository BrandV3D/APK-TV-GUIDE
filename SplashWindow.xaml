<Window x:Class="SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="400" Width="600" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FF001B2F" AllowsTransparency="False">
    <Grid>
        <Grid Background="#FF001B2F">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="BtnSplashGuide" Width="160" Height="120" Margin="12" Background="#FF03263C" BorderBrush="#FF0B2B45" BorderThickness="2" Foreground="White" FontWeight="Bold">TV GUIDE</Button>
                <Button x:Name="BtnSplashChannels" Width="160" Height="120" Margin="12" Background="#FF03263C" BorderBrush="#FF0B2B45" BorderThickness="2" Foreground="White" FontWeight="Bold">CHANNELS</Button>
                <Button x:Name="BtnSplashPlayback" Width="160" Height="120" Margin="12" Background="#FF03263C" BorderBrush="#FF0B2B45" BorderThickness="2" Foreground="White" FontWeight="Bold">PROGRAMMING</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
