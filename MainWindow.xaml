<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVMoviesChannelGuide"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Background="#FF1E90FF"
        Title="MainWindow" Height="720" Width="1280" WindowState="Maximized">
    <Window.Resources>
        <SolidColorBrush x:Key="LightHighlight" Color="#FF5DA9FF" />
        <Style x:Key="ChannelItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightHighlight}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="WindowBackground" Color="#FF001B2F" />
        <SolidColorBrush x:Key="InnerBackground" Color="#FF03263C" />
        <SolidColorBrush x:Key="TextOnDark" Color="White" />
        <SolidColorBrush x:Key="ElementBorder" Color="#FF0B2B45" />
        <SolidColorBrush x:Key="TimelineBlockBrush" Color="#FF123B5A" />
        <SolidColorBrush x:Key="ProgressBackground" Color="#FF021426" />
        <!-- Force white foreground for common text elements -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="8" Background="{StaticResource InnerBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" MinWidth="160" />
            <ColumnDefinition Width="3*" MinWidth="260" />
            <ColumnDefinition Width="2.5*" MinWidth="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="148*" />
                <ColumnDefinition Width="241*"/>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Menu Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,37" Grid.RowSpan="2" Background="#FF03263C">
                <MenuItem Header="Menu">
                    <MenuItem Header="Home" x:Name="MenuHome" />
                    <MenuItem Header="Channels Grid" x:Name="MenuChannelsGrid" />
                    <MenuItem Header="Edit Channels" x:Name="MenuEditChannels" />
                    <MenuItem Header="Guide" x:Name="MenuGuide" />
                    <MenuItem Header="Live TV" x:Name="MenuLiveTv" />
                </MenuItem>
            </Menu>
            <Image x:Name="TV_Set_Icon" Source="/Icon_Guide.ico" Stretch="Uniform" Grid.Column="2" Margin="42,6,709,0" Height="32" VerticalAlignment="Top"/>

            <TextBlock Grid.Column="2" Text="TV GUIDE" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="28" FontWeight="Bold" Foreground="White" Margin="79,4,0,0" Grid.RowSpan="2" />
            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,568,0" VerticalAlignment="Center" Height="45">
                <Button x:Name="btn_GoTo_TV_Guide" Content="TV Guide" Width="171" Margin="0,0,8,0" Height="43" Background="#FF014F98"/>
                <Button x:Name="btn_Guide" Content="Guide" Width="140" Margin="0,0,8,0" Background="#FF014F98"/>
                <Button x:Name="btn_LiveTv" Content="Live TV" Width="140" Margin="0,0,16,0" Background="#FF014F98"/>
            </StackPanel>
        </Grid>
        <!-- Top time ruler / menu showing half-hour ticks across X hours -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource InnerBackground}" Padding="6" Margin="0,48,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnRulerLeft" Content="◀" Padding="6" Margin="0,0,6,0" />
                <Button x:Name="BtnRulerRight" Content="▶" Padding="6" Margin="0,0,6,0" />
                <ToggleButton x:Name="BtnRuler24Toggle" Content="24H" Padding="6" Margin="0,0,6,0" />
                <ScrollViewer x:Name="TimeRulerScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TimeRuler" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="TimeRulerTranslate" />
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="2" Background="{Binding Background}" MouseLeftButtonUp="TimeRulerItem_Click" Width="{Binding Width, ElementName=TimeLabel}">
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ListBox x:Name="LstChannels" Grid.Row="1" Grid.Column="0" Background="{StaticResource InnerBackground}" Foreground="{StaticResource TextOnDark}" ItemContainerStyle="{StaticResource ChannelItemStyle}" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Image Width="48" Height="32" Source="{Binding LogoPath}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="1" Grid.Column="1">
            <ListView x:Name="LstPrograms" DockPanel.Dock="Top" Height="300" Background="{StaticResource InnerBackground}" Foreground="{StaticResource TextOnDark}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,4" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="6,4" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ElementBorder}" BorderThickness="1" Padding="6" Margin="0,6,0,0" Background="{StaticResource InnerBackground}">
                <StackPanel>
                    <TextBlock Text="Program Details" FontWeight="Bold" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtProgramDetails" Text="(select a program)" TextWrapping="Wrap" Foreground="{StaticResource TextOnDark}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Raw file listing of the selected channel's Schedual folder -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ElementBorder}" BorderThickness="1" Padding="6" Margin="0,6,0,0" Background="{StaticResource InnerBackground}">
                <StackPanel>
                    <TextBlock Text="Schedual Folder Files" FontWeight="Bold" />
                    <ListView x:Name="SchedualFilesListView" Height="120" Background="{StaticResource InnerBackground}" Foreground="{StaticResource TextOnDark}" MouseDoubleClick="SchedualFilesListView_MouseDoubleClick" />
                </StackPanel>
            </Border>

            <!-- Timeline area: 24-hour schedule for the selected channel -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ElementBorder}" BorderThickness="1" Padding="6" Margin="0,6,0,0" Background="{StaticResource InnerBackground}">
                <StackPanel>
                    <TextBlock Text="Timeline (24-hour schedule)" FontWeight="Bold" />
                    <ListView x:Name="TimelineListView" Height="220" Background="{StaticResource InnerBackground}" Foreground="{StaticResource TextOnDark}" MouseDoubleClick="TimelineListView_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource NowPlayingBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF8FD3FF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource NowPlayingForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextOnDark}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource NowPlayingForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Now playing -->
        <TextBlock x:Name="TxtNowPlaying" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="(nothing playing)" FontWeight="Bold" Foreground="{StaticResource TextOnDark}" />

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{StaticResource ElementBorder}" BorderThickness="1" Padding="4" Background="{StaticResource InnerBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- LibVLC VideoView -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ImgChannelLogoLarge" Grid.Column="0" Width="120" Height="80" Margin="4" />
                    <vlc:VideoView x:Name="VideoView" Grid.Column="1" Background="{StaticResource WindowBackground}" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <Grid Margin="4,0,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeCurrentLabel" Grid.Column="0" Text="0:00" Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="ScrubSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center"
                                PreviewMouseDown="ScrubSlider_PreviewMouseDown" PreviewMouseUp="ScrubSlider_PreviewMouseUp" ValueChanged="ScrubSlider_ValueChanged" />
                        <TextBlock x:Name="TimeTotalLabel" Grid.Column="2" Text="0:00" Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPlay" Content="Play" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnPause" Content="Pause" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnStop" Content="Stop" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnMaximizeVideo" Content="Maximize" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnOpenExternalVlc" Content="Play in VLC" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnPlayNowInPlayer" Content="Play Now (Player.xaml)" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnSubtitles" Content="CC: Off" Padding="8,4" Margin="4" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <Button x:Name="BtnMute" Content="Mute" Padding="8,4" Margin="12,0,4,0" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" />
                        <TextBlock Text="Volume" Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="VolumeLabel" Text="100%" Foreground="{StaticResource TextOnDark}" VerticalAlignment="Center" Width="36" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="BtnHome" Content="HOME" Grid.RowSpan="99" Grid.ColumnSpan="99" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Padding="10,6" Margin="10" Background="#FF223344" BorderBrush="{StaticResource ElementBorder}" Foreground="{StaticResource TextOnDark}" FontWeight="Bold" />
    </Grid>
</Window>
