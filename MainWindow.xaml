<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVMoviesChannelGuide"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Button x:Name="BtnSelectFolder" Content="Select Root Folder" Padding="8,4" Margin="0,0,8,0" />
            <TextBlock x:Name="TxtRootPath" VerticalAlignment="Center" Text="(no folder selected)" />
        </StackPanel>

        <ListBox x:Name="LstChannels" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Name" />

        <DockPanel Grid.Row="1" Grid.Column="1">
            <ListView x:Name="LstPrograms" DockPanel.Dock="Top" Height="300">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Start" DisplayMemberBinding="{Binding Start}" Width="140" />
                        <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="300" />
                        <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration}" Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Program Details" FontWeight="Bold" />
                    <TextBlock x:Name="TxtProgramDetails" Text="(select a program)" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- LibVLC VideoView -->
                <vlc:VideoView x:Name="VideoView" Grid.Row="0" />
                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="BtnPlay" Content="Play" Padding="8,4" Margin="4" />
                    <Button x:Name="BtnPause" Content="Pause" Padding="8,4" Margin="4" />
                    <Button x:Name="BtnStop" Content="Stop" Padding="8,4" Margin="4" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
