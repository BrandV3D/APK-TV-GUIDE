<Window x:Class="Player"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVMoviesChannelGuide"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Background="Black"
        Title="Player" Height="450" Width="800" WindowStartupLocation="CenterOwner" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <vlc:VideoView x:Name="VideoView" Grid.Row="0" />
        <StackPanel Grid.Row="1" Background="#FF223C8C">
            <Grid Margin="12,6,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeCurrentLabel" Grid.Column="0" Text="0:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="ScrubSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center"
                        PreviewMouseDown="ScrubSlider_PreviewMouseDown" PreviewMouseUp="ScrubSlider_PreviewMouseUp" ValueChanged="ScrubSlider_ValueChanged" />
                <TextBlock x:Name="TimeTotalLabel" Grid.Column="2" Text="0:00" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Button x:Name="BtnPlay" Content="Play" Padding="8,4" Margin="8,6,4,6" Background="#FF223344" Foreground="White" />
                <Button x:Name="BtnPause" Content="Pause" Padding="8,4" Margin="4,6" Background="#FF223344" Foreground="White" />
                <Button x:Name="BtnStop" Content="Stop" Padding="8,4" Margin="4,6" Background="#FF223344" Foreground="White" />
                <Button x:Name="BtnMaximize" Content="Maximize" Padding="8,4" Margin="4,6" Background="#FF223344" Foreground="White" />
                <Button x:Name="BtnSubtitles" Content="CC: Off" Padding="8,4" Margin="4,6" Background="#FF223344" Foreground="White" />
                <Button x:Name="BtnMute" Content="Mute" Padding="8,4" Margin="4,6" Background="#FF223344" Foreground="White" />
                <TextBlock Text="Volume" Foreground="White" VerticalAlignment="Center" Margin="8,6,8,6" />
                <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock x:Name="VolumeLabel" Text="100%" Foreground="White" VerticalAlignment="Center" Width="40" Margin="4,6,8,6" />
            </StackPanel>
        </StackPanel>

        <Button x:Name="BtnHome" Content="HOME" Grid.RowSpan="99" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Padding="10,6" Margin="10" Background="#FF216DD2" Foreground="White" FontWeight="Bold" />
    </Grid>
</Window>
