<Window x:Class="TV_Guide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TVMoviesChannelGuide"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="Prevue Guide Channel" Height="600" Width="900" WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#FF001233">
    <Grid Background="#FF001233">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: live preview window + digital clock + "now showing" -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border BorderBrush="#FFFFD700" BorderThickness="4" CornerRadius="4">
                    <vlc:VideoView x:Name="PreviewVideo" Width="320" Height="240" Background="Black" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnMaximize" Content="Maximize" Padding="8,4" Margin="0,0,4,0" Background="#FF223344" Foreground="White" BorderBrush="#FFFFD700" />
                    <Button x:Name="BtnMute" Content="Mute" Padding="8,4" Margin="0,0,4,0" Background="#FF223344" Foreground="White" BorderBrush="#FFFFD700" />
                    <Button x:Name="BtnOpenExternalVlc" Content="Play in VLC" Padding="8,4" Margin="0,0,4,0" Background="#FF223344" Foreground="White" BorderBrush="#FFFFD700" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Volume" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock x:Name="VolumeLabel" Text="70%" Foreground="White" VerticalAlignment="Center" Width="36" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PREVUE GUIDE" FontSize="44" FontWeight="Bold" Foreground="#FFFFD700" FontFamily="Consolas" />
                <TextBlock x:Name="ClockText" Text="--:--:-- --" FontSize="30" Foreground="White" FontFamily="Consolas" Margin="0,4,0,0" />
                <TextBlock x:Name="NowShowingText" Text="Loading channel guide..." FontSize="20" Foreground="#FF8FE0FF" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnCloseGuide" Content="Exit" VerticalAlignment="Top" Padding="14,6" Background="#FF223344" Foreground="White" FontWeight="Bold" BorderBrush="#FFFFD700" />
        </Grid>

        <!-- Channel listing -->
        <Border Grid.Row="1" Background="#FF001B4D" BorderBrush="#FF0B2B45" BorderThickness="0,3,0,3" Margin="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ScrollPanel" HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </Border>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="#FFFFD700" Height="44">
            <TextBlock x:Name="MarqueeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#FF001233" FontFamily="Consolas" Text="WELCOME TO THE GUIDE" />
        </Border>

        <Button x:Name="BtnHome" Content="HOME" Grid.RowSpan="99" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Padding="10,6" Margin="10" Background="#FF216DD2" Foreground="White" FontWeight="Bold" BorderBrush="#FFFFD700" />
    </Grid>
</Window>
